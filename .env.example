# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_LIST_KEY=weibo:items
REDIS_TASK_DATA_PREFIX=weibo:task:data:

# Sentiment
SENTI_DIR_PATH=
SENTI_ENABLED=1
SENTI_USE_REDIS=1
SENTI_REDIS_PREFIX=weibo:senti:
SENTI_CACHE_TTL=60

# Hotwords
HOTWORDS_ENABLED=1
HOTWORDS_TOP_N=20
HOTWORDS_MIN_LEN=2
HOTWORDS_MIN_COUNT=1

# MySQL
MYSQL_ENABLED=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DBNAME=yuqing
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
HOTWORDS_MYSQL_ENABLED=0

# Elasticsearch
ES_ENABLED=0
ES_HOSTS=http://127.0.0.1:9200
ES_INDEX_WEIBO=weibocontent

# monitor_Mix Redis queue
MONITOR_REDIS_ENABLED=0
MONITOR_REDIS_HOST=
MONITOR_REDIS_PORT=
MONITOR_REDIS_DB=12
MONITOR_REDIS_PASSWORD=
MONITOR_REDIS_KEY=weibo_spider:start_urls

# monitor_Mix MySQL
MONITOR_MYSQL_ENABLED=0
MONITOR_MYSQL_HOST=
MONITOR_MYSQL_PORT=
MONITOR_MYSQL_DBNAME=
MONITOR_MYSQL_USER=
MONITOR_MYSQL_PASSWORD=
MONITOR_MYSQL_CHARSET=utf8mb4

# task defaults
DEFAULT_MAX_PAGES=3

# task spider autostart
MONITOR_SPIDER_AUTOSTART=1
MONITOR_TASK_SPIDER_CMD=uv run scrapy crawl weibo_search
MONITOR_TASK_SPIDER_LOCK_PREFIX=weibo:task:running:
MONITOR_DEFAULT_WITH_COMMENTS=1

# comments
COMMENT_MAX_PAGES=5
REDIS_TASK_COMMENTS_PREFIX=weibo:task:comments:
COMMENT_QUEUE_ENABLED=1
REDIS_COMMENT_QUEUE_PREFIX=weibo:comment:queue:
REDIS_COMMENT_QUEUE_KEY=weibo:comment:queue
COMMENT_SPIDER_AUTOSTART=1
COMMENT_SCROLL_MODE=network
COMMENT_IDLE_MS=2500
COMMENT_MAX_SCROLLS=50

# proxies
PROXY_ENABLED=0
PROXY_LIST=
PROXY_INDEX_LIST=weibo:proxies
PROXY_INDEX_SET=weibo:proxies:set

# headers
ACCEPT_LANGUAGE=zh-CN,zh;q=0.9,en;q=0.8
USER_AGENT_LIST=
ACCEPT=
ACCEPT_ENCODING=
SEC_CH_UA=
SEC_CH_UA_MOBILE=
SEC_CH_UA_PLATFORM=
UPGRADE_INSECURE_REQUESTS=
DNT=
EXTRA_HTTP_HEADERS_JSON=

# pacing
REQUEST_PAUSE_MIN_MS=800
REQUEST_PAUSE_MAX_MS=1600

# context profile
VIEWPORT_WIDTH=
VIEWPORT_HEIGHT=
VIEWPORT_LIST=390x844,414x896,375x812
DEVICE_SCALE_FACTOR=
IS_MOBILE=
HAS_TOUCH=
LOCALE=
TIMEZONE_ID=

# cookie bundles
COOKIE_BUNDLE_PREFIX=weibo:cookie:bundle:
COOKIE_BUNDLE_INDEX_LIST=weibo:cookie:bundles
COOKIE_BUNDLE_ONLY=0
COOKIE_BUNDLE_INDEX_SET=weibo:cookie:bundles:set

# Task keys
TASK_ID_KEY=weibo:task:id
TASK_INDEX_LIST=weibo:tasks
TASK_INDEX_SET=weibo:tasks:set
TASK_LOG_PREFIX=weibo:task:logs:

# Cookie keys
COOKIE_PREFIX=weibo:cookie:
COOKIE_INDEX_LIST=weibo:cookies
COOKIE_INDEX_SET=weibo:cookies:set
USE_REDIS_COOKIES=1
